g-clickable="false" password="false" selected="false" bounds="[326,635][499,698]" /><node index="6" text="金、水" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[499,635][629,698]" /><node index="7" text="幸运色：" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[326,709][499,772]" /><node index="8" text="玄黑色" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[499,709][629,772]" /><node index="9" text="吉利方位：" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[326,783][543,846]" /><node index="10" text="北方" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[543,783][630,846]" /><node index="11" text="今日干支「壬申」，天干壬（水）、地支申（金），对日主壬而言天干见水为喜用为主调。这一段是明显可以借力的时候。 今日地支走金，正落在你命局喜用的五行上：这类日子不必勉强，事情本身就在往你这边倾斜，宜把主力时间花在真正要紧的那件事上。 把申摆在你日干壬的十二长生上，这一周期你自身的气数落在「长生」：如草木初萌，学什么、起手做什么吸收得最快。体感上就是：同一件事，这周期你办起来的省力程度和上周期完全不一样。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,894][996,1416]" /><node index="12" text="怎么办" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1448][181,1494]" /><node index="13" text="今日天干见水为喜用、地支见金为喜用、壬日主临申为「长生」——趁势推进，别停在原地等更好的时机。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1510][996,1626]" /><node index="14" text="今日分项详批" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1668][996,1731]" /><node index="15" text="事业运" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1752][214,1815]" /><node index="16" text="76 分" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[906,1757][996,1810]" /><node index="17" text="" resource-id="" class="android.widget.ProgressBar" package="com.xuanji.app" content-desc