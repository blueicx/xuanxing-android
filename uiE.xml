e" long-clickable="false" password="false" selected="false" bounds="[326,635][499,698]" /><node index="6" text="金、水" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[499,635][629,698]" /><node index="7" text="幸运色：" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[326,709][499,772]" /><node index="8" text="金银白" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[499,709][629,772]" /><node index="9" text="吉利方位：" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[326,783][543,846]" /><node index="10" text="西方" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[543,783][630,846]" /><node index="11" text="本年干支依序为「丙午、丙申」。本年天干走火，是你命局里的忌神：同样一句话，平日说说无妨，这几天说出来就容易被接歪。宜减事、宜缓口、宜把决定往后压一压。本年地支走火，是你命局里的忌神：同样一句话，平日说说无妨，这几天说出来就容易被接歪。宜减事、宜缓口、宜把决定往后压一压。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,894][996,1242]" /><node index="12" text="怎么办" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1274][181,1320]" /><node index="13" text="本年在「天干见火为忌神」这一处、「地支见火为忌神」、「丙是日主壬之偏财（见其为忌之短）」——气机逆乱，凡是退一步，先保住根本。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1336][996,1510]" /><node index="14" text="本年分项详批" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1552][996,1615]" /><node index="15" text="事业运" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1636][214,1699]" /><node index="16" text="6 分" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[927,1641][996,1694]" /><node index="17" text="" resource-id="" class="android.widget.ProgressBar" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1710][996,1726]" /><node index="18" text="事业运处在低谷，先守住别丢东西。依据是：天干见火（忌神），易生枝节；地支见火（忌神），易生枝节。这周期少开口多落纸，把口径留痕比表现自己有用。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1742][996,1872]" /><node index="19" text="财运" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1909][171,1972]" /><node index="20" text="6 分" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[927,1914][996,1967]" /><node index="21" text="" resource-id="" class="android.widget.ProgressBar" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1983][996,1999]" /><node index="22" text="财运处在低谷，先守住别丢东西。依据是：天干见火（忌神），钱财上宜保守；地支见火（忌神），钱财上宜保守。不宜垫资、不宜借出、不宜在这段周期里做大额决策。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2015][996,2127]" /></node></node><node index="8" text="" resource-id="" class="android.view.V