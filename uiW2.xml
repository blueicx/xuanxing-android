led="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[42,352][1038,2127]"><node index="0" text="本年实算 365 天真实星历：木星、天王星、水星、冥王星、海王星、土星、金星处于逆行；木星、土星、天王星、海王星换座；望日（满月）2026-02-02；另有 177 组行运相位与本命盘发生作用。外境确有摩擦，宜减事、宜慢半拍。本年行运冥王星走到水瓶座4°（水瓶座），与你的本命北交（狮子座4°）构成冲。冥王星是权力的真相，它逼你面对「我到底在控制什么」，冲给的是对面来的要求，你要么谈判，要么被它推着走。被触发的是你这辈子要走去的方向，落在北交所在的第四宫（家宅、根基、内心归属、晚年）。有权力斗争的味道。别逼对方认输，也别交出底牌；把注意力收回到自己的事上。本年行运冥王星走到水瓶座2°（水瓶座），与你的本命上升（金牛座3°）构成刑。冥王星是权力的真相，它逼你面对「我到底在控制什么」，刑给的是非做不可却不想做的事，拖着它就会以内部摩擦的形式反复出现。被触发的是你这个人本身、你的门面与身体，落在上升所在的第一宫（自身形象、身体、你给人的第一印象）。有权力斗争的味道。别逼对方认输，也别交出底牌；把注意力收回到自己的事上。" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,415][996,1478]" /><node index="1" text="本年分项详批" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1520][996,1583]" /><node index="2" text="事业运" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1604][214,1667]" /><node index="3" text="36 分" resource-id="" class="android.widget.TextView" package="com.xuanji.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[906,1609][996,1662]" /><node index="4" text="" resource-id="" class="android.widget.ProgressBar" package="com.xuanji.app